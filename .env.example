# Copy this file to .env at the repository root for local development.
# Process environment variables override .env. Restart both servers after edits.
PROJECT_NAME="VAULT Core"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Optional backend-only database URL. Health check does not require PostgreSQL.
# Example format only: postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/vault
# Keep real credentials in your untracked .env, never in this example.
DATABASE_URL=""
# Explicitly enable the internal, synthetic-data preview after database setup.
# This is NOT authentication and must not be exposed to buyers or the Internet.
INTERNAL_PREVIEW_ENABLED=false
# Backend-only local document store; relative paths resolve from repository root.
UPLOAD_DIRECTORY=".data/uploads"
MAX_UPLOAD_BYTES=10485760

# Public browser configuration. Never put secrets in a VITE_ variable.
VITE_API_BASE_URL="/api/v1"
# Used only by the Vite dev/preview server, not embedded in browser code.
BACKEND_PROXY_TARGET="http://127.0.0.1:8000"

# Legacy demo placeholders below are NOT used by the new backend.
SECRET_KEY=""
DEFAULT_TOKEN_EXPIRY_DAYS=14
ENABLE_DYNAMIC_WATERMARK=true
DRM_PREVENT_DOWNLOAD=true
TELEGRAM_BOT_TOKEN=""
TELEGRAM_APPROVAL_CHAT_ID=""
ESIGN_WEBHOOK_SECRET=""

# Hosted full-stack demo controls. Leave empty for local-only behavior.
# ALLOWED_HOSTS is the backend host, e.g. vault-core-api.onrender.com or a custom Railway domain.
# Railway-provided domains are read from RAILWAY_PUBLIC_DOMAIN automatically at runtime.
# ALLOWED_ORIGINS is the frontend origin, e.g. https://frontend-xi-eosin-36.vercel.app.
ALLOWED_HOSTS=""
ALLOWED_ORIGINS=""
RAILWAY_PUBLIC_DOMAIN=""
# Optional light demo gate. This is not production authentication/RBAC.
DEMO_PASSWORD=""
