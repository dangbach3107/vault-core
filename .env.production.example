# Production Environment Configuration for VAULT Core

PROJECT_NAME="VAULT Core"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Set to true to activate data rooms and company profiles
INTERNAL_PREVIEW_ENABLED=true

# Set to true for cloud hosting (Render, Koyeb, Vercel, VPS) to allow non-localhost traffic
ALLOW_PUBLIC_ACCESS=true

# Allowed CORS origins (comma-separated or * for all)
CORS_ORIGINS="*"

# Neon PostgreSQL connection string (MUST start with postgresql+psycopg://)
# Example: postgresql+psycopg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Storage directory for uploaded documents
UPLOAD_DIRECTORY=".data/uploads"
MAX_UPLOAD_BYTES=10485760

# Frontend API URL (Used when frontend is deployed on Vercel/Cloudflare Pages)
# Example: https://vault-core-backend.onrender.com/api/v1
VITE_API_BASE_URL="/api/v1"
